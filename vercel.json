{
  "version": 2,
  "builds": [
    { "src": "api/iol.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" },
    { "src": "*.json", "use": "@vercel/static" },
    { "src": "*.svg", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/iol", "dest": "/api/iol.js" },
    { "src": "/sw.js", "dest": "/sw.js" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/icon.svg", "dest": "/icon.svg" },
    { "src": "/cumpleanos.html", "dest": "/cumpleanos.html" },
    { "src": "/merval.html", "dest": "/merval.html" },
    { "src": "/cedears.html", "dest": "/cedears.html" },
    { "src": "/bonos.html", "dest": "/bonos.html" },
    { "src": "/bonospesos.html", "dest": "/bonospesos.html" },
    { "src": "/lecaps.html", "dest": "/lecaps.html" },
    { "src": "/roa-catalogo.html", "dest": "/roa-catalogo.html" },
    { "src": "/roa-cliente.html", "dest": "/roa-cliente.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
