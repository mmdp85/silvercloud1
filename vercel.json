{
  "version": 2,
  "builds": [
    { "src": "api/iol.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "merval.html", "use": "@vercel/static" },
    { "src": "cedears.html", "use": "@vercel/static" },
    { "src": "bonos.html", "use": "@vercel/static" },
    { "src": "bonospesos.html", "use": "@vercel/static" },
    { "src": "lecaps.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/iol", "dest": "/api/iol.js" },
    { "src": "/merval.html", "dest": "/merval.html" },
    { "src": "/cedears.html", "dest": "/cedears.html" },
    { "src": "/bonos.html", "dest": "/bonos.html" },
    { "src": "/bonospesos.html", "dest": "/bonospesos.html" },
    { "src": "/lecaps.html", "dest": "/lecaps.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
